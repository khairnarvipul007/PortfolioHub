# Single-container fullstack image (ideal for Render, Railway, or Fly.io)
FROM node:22-alpine AS client-builder

WORKDIR /client

COPY package*.json ./
RUN npm ci

COPY index.html vite.config.js tailwind.config.js postcss.config.js ./
COPY src ./src

ENV VITE_API_URL=/api
ENV VITE_SOCKET_URL=

RUN npm run build

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV SERVE_CLIENT=true
ENV PORT=5000

COPY server/package*.json ./
RUN npm ci --omit=dev

COPY --chown=node:node server ./
COPY --from=client-builder --chown=node:node /client/dist ./public

USER node

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 5000) + '/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
